---
import Page from '../../layouts/Page.astro';
import services from '../../data/services.json';
import OriginalContent from '../../components/OriginalContent.astro';
export function getStaticPaths() { return services.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<Page title={service.title} description={service.description} service={service.title}>
<OriginalContent path={`/service/${service.slug}/`} />
<h2 id="related-solutions">¿Qué seguro es el adecuado para ti?</h2><ul class="service-links">{services.filter(s => s.slug !== service.slug).map(s => <li><a href={`/service/${s.slug}/`}>{s.title}</a><p>{s.description}</p></li>)}</ul>
</Page>
