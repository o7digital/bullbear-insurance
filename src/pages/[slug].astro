---
import Page from '../layouts/Page.astro';
import posts from '../data/posts.json';
import ContactForm from '../components/ContactForm.astro';
import { forms } from '../../cms/forms.mjs';
import { site } from '../lib/site';
export function getStaticPaths() { return [...posts.map(post => ({ params: { slug: post.slug }, props: { post } })), ...Object.entries(forms).filter(([variant])=>variant!=='general').map(([variant,form])=>({params:{slug:form.path.slice(1,-1)},props:{variant,form}}))]; }
const { post, variant, form } = Astro.props;
const description = post?.blocks.find(block => block.tag === 'p')?.text.slice(0, 160) || post?.title;
// Source timestamps have no offset. Keep their published calendar date independent of the build host.
const archiveDate = post?.date.slice(0, 10).split('-').reverse().map(Number).join('/');
---
{form ? <Page title={form.title} description={form.description}><div class="contact-page-grid"><div><h2>Solicita información</h2><p><a href={`mailto:${site.email}`}>{site.email}</a></p><p><a href="tel:+525515100605">{site.phone}</a></p><address>{site.address}</address></div><ContactForm variant={variant} /></div></Page> : <Page title={post.title} description={description} type="article"><p class="source-note">Artículo del sitio actual · {archiveDate}. Información general sujeta a revisión y a las condiciones de cada póliza.</p>{post.image && <img class="source-post-image" src={post.image} alt={post.title} width="1024" height="683" loading="lazy" />}{post.blocks.map(block => ['h1','h2','h3','h4'].includes(block.tag) ? <h2>{block.text}</h2> : block.tag === 'li' ? <p>• {block.text}</p> : <p>{block.text}</p>)}<a class="button" href="/contacto/">Consultar con un asesor <span aria-hidden="true">↗</span></a></Page>}
