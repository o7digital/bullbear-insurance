---
import ContactForm from '../components/ContactForm.astro';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import OriginalContent from '../components/OriginalContent.astro';
import original from '../data/original-content.json';
const widgets = original.pages['/'].widgets;
const widget = id => widgets.find(item => item.id === id);
const text = id => widget(id).blocks.find(block => block.tag !== 'a')?.text || '';
const process = ['ee60330','386e75f','3dba684'].map(id => original.shared.process.find(item => item.id === id));
const features = [['9c88eef','e497bb8'],['3fd6fb7','2068e2d'],['7a0d9ad','21e2e7d']];
---
<!doctype html><html lang="es-MX"><head><SEO title="Bull & Bear Insurance Broker | Seguros en México" description="Asesoría y asistencia en la administración de riesgos. Seguros personales, empresariales, protección de datos y líneas financieras." /></head>
<body class="source-home">
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <div class="concept-bar"><div class="container"><span>BULL &amp; BEAR</span><span>INSURANCE BROKER</span></div></div>
  <Header home />
  <main id="contenido" data-source-page="/">
    <Hero />

    <section class="philosophy" id="filosofia" data-home-section="company"><div class="container philosophy-grid">
      <div class="philosophy-aside"><span class="section-number">01</span></div>
      <div class="philosophy-heading" data-source-widget="13bdf0e"><h2>{text('13bdf0e')}</h2></div>
      <div class="philosophy-copy" data-source-widget="74063de"><p>{original.shared.philosophy}</p><a class="line-link" href="/sobre-nosotros/">Sobre nosotros <span aria-hidden="true">↗</span></a></div>
      <div class="philosophy-mark" aria-hidden="true">B<span>&amp;</span>B</div>
    </div></section>

    <section class="process source-process" id="enfoque" data-home-section="approach"><div class="container"><div class="process-rows">{process.map((item,i)=><div class="process-row" data-source-widget={item.id}><span class="process-no">{String(i+1).padStart(2,'0')}</span><h3>{item.blocks.find(block=>block.tag==='h2')?.text}</h3><p>{item.blocks.filter(block=>block.tag==='p').map(block=>block.text).join(' ')}</p><span class="process-icon" aria-hidden="true"><img class="source-process-icon" src={item.images[0].src} alt="" width="30" height="30" loading="lazy" /></span></div>)}</div></div></section>

    <section class="source-highlights" data-home-section="featured"><div class="container"><div class="source-feature-cards">{features.map(([imageId,copyId])=><article class="source-feature-card"><div data-source-widget={imageId}><img class="source-feature-image" src={widget(imageId).images[0].src} alt={widget(imageId).images[0].alt} loading="lazy" decoding="async" /></div><OriginalContent path="/" widgets={[widget(copyId)]} /></article>)}</div></div></section>

    <section class="solutions source-personal" id="soluciones" data-home-section="personal"><div class="container"><div class="section-head"><div><p class="eyebrow dark" data-source-widget="999900f">{text('999900f')}</p><h2 id="solutions-title" data-source-widget="c6a628d">{text('c6a628d')}</h2></div></div><OriginalContent path="/" widgets={[widget('ee9cca3')]} />
      <aside class="source-quote-banner"><div data-source-widget="74977ed"><h2>{text('74977ed')}</h2><a class="line-link inverse" href="/formulario-cuidado-de-personas/">Contáctanos <span aria-hidden="true">↗</span></a></div><div data-source-widget="19525c5"><img src={widget('19525c5').images[0].src} alt="" loading="lazy" decoding="async" /></div></aside>
    </div></section>

    <section class="solutions source-business" data-home-section="business"><div class="container"><div class="section-head"><div><p class="eyebrow dark" data-source-widget="9ae026a">{text('9ae026a')}</p><h2 data-source-widget="ebca75b">{text('ebca75b')}</h2></div></div><OriginalContent path="/" widgets={[widget('8e3c9cf')]} />
      <aside class="source-quote-banner"><div data-source-widget="cb332dc"><h2>{text('cb332dc')}</h2><a class="line-link inverse" href="/formulario-danos/">Contáctanos <span aria-hidden="true">↗</span></a></div><div data-source-widget="17c8a4b"><img src={widget('17c8a4b').images[0].src} alt="" loading="lazy" decoding="async" /></div></aside>
    </div></section>

    <section class="contact" id="contacto" data-home-section="contact" aria-labelledby="contact-title"><div class="container contact-grid"><div class="contact-copy"><div data-source-widget="ddfd51b"><h2 id="contact-title">{text('ddfd51b')}</h2></div><p>{original.shared.footer.question}</p><div class="contact-lines"><a href="mailto:contacto@bullandbear-insurancebroker.com">contacto@bullandbear-insurancebroker.com <span>↗</span></a><a href="tel:+525515100605">+52 55 1510 0605 <span>↗</span></a></div><div data-source-widget="db57cd1"><a class="line-link inverse" href="/contacto/">Contacto <span aria-hidden="true">↗</span></a></div></div><ContactForm /></div></section>

    <section class="source-articles" data-home-section="articles"><div class="container"><OriginalContent path="/" widgets={[widget('c72a1c4')]} /></div></section>
  </main><Footer />
</body></html>
