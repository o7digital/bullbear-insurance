---
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
const { title, description, service, type } = Astro.props;
---
<!doctype html><html lang="es-MX"><head><SEO title={`${title} | Bull & Bear Insurance Broker`} description={description} service={service} type={type} /></head><body class="inner-page"><a class="skip" href="#contenido">Saltar al contenido</a><div class="concept-bar"><div class="container"><span>VISTA PREVIA · BULL &amp; BEAR</span><span>VERSIÓN EN REVISIÓN</span></div></div><Header /><main id="contenido"><section class="page-hero"><div class="container"><a class="eyebrow" href="/">BULL &amp; BEAR / INICIO</a><h1>{title}</h1><p>{description}</p></div></section><section class="page-body container"><slot /></section></main><Footer /></body></html>
