---
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';
const { title, description, service, type } = Astro.props;
---
<!doctype html><html lang="es-MX"><head><SEO title={`${title} | Bull & Bear Insurance Broker`} description={description} service={service} type={type} /></head><body class="inner-page"><a class="skip" href="#contenido">Saltar al contenido</a><div class="concept-bar"><div class="container"><span>VISTA PREVIA · BULL &amp; BEAR</span><span>VERSIÓN EN REVISIÓN</span></div></div><header class="site-header" id="inicio"><div class="header-content container"><a class="logo" href="/" aria-label="Bull & Bear — inicio"><span class="logo-symbol"><b>B</b><i>&amp;</i><b>B</b></span><span class="logo-text"><strong>BULL <em>&amp;</em> BEAR</strong><small>INSURANCE BROKER</small></span></a><nav class="nav" id="primary-navigation" aria-label="Navegación principal"><a href="/sobre-nosotros/">Nosotros</a><a href="/#soluciones">Soluciones</a><a href="/#enfoque">Nuestro enfoque</a><a href="/contacto/">Contacto</a></nav><a href="/contacto/" class="header-cta">Hablemos <span aria-hidden="true">↗</span></a><button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Abrir menú"><span></span><span></span></button></div></header><main id="contenido"><section class="page-hero"><div class="container"><a class="eyebrow" href="/">BULL &amp; BEAR / INICIO</a><h1>{title}</h1><p>{description}</p></div></section><section class="page-body container"><slot /></section></main><Footer /></body></html>
