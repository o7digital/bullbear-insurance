<form id="interest-form" class="contact-form" method="post" action="/api/contact" aria-describedby="contact-notice" data-success="Gracias. Tu solicitud se ha recibido. Nuestro equipo se pondrá en contacto contigo." data-error="No pudimos enviar tu solicitud. Inténtalo de nuevo o escríbenos por correo." data-pending="Enviando…">
  <div class="form-top"><span>CONTACTO / 01</span><span>ASESORÍA PERSONALIZADA</span></div>
  <h3>Hablemos de<br/><em>tu futuro.</em></h3>
  <label for="name">Nombre</label><input id="name" maxlength="100" name="name" type="text" placeholder="Tu nombre" autocomplete="name" required />
  <label for="email">Correo electrónico</label><input id="email" maxlength="254" name="email" type="email" placeholder="nombre@empresa.com" autocomplete="email" required />
  <label for="service">¿Qué te gustaría proteger?</label><select name="service" id="service" required><option value="" disabled selected>Selecciona una opción</option><option value="personal">Personas y patrimonio</option><option value="business">Empresas y negocios</option><option value="financial">Líneas financieras</option><option value="general">Asesoría general</option></select>
  <div class="form-trap" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
  <label class="consent"><input type="checkbox" name="consent" required /> <span>He leído el <a href="/aviso-de-privacidad/">aviso de privacidad</a> y acepto el uso de mis datos para atender esta solicitud.</span></label>
  <button class="form-submit" type="submit">Solicitar asesoría <span aria-hidden="true">↗</span></button><p class="form-privacy" id="contact-notice">Usaremos tu nombre, correo y área de interés para responder a tu solicitud. No incluyas información médica ni documentos.</p><p class="form-message" id="form-message" role="status" aria-live="polite"></p>
</form>
